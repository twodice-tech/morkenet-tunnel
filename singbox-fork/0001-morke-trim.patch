+// Size probe: links exactly what experimental/libbox links, so tag/registry changes
+// can be measured in seconds instead of a full gomobile bind.
+package main
+
+import (
+	"fmt"
+
+	"github.com/sagernet/sing-box/experimental/libbox"
+)
+
+func main() {
+	fmt.Println(libbox.Version())
+}
